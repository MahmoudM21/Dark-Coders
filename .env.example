# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_URL="http://localhost:18789"
OPENCLAW_API_KEY=""
VITE_OPENCLAW_GATEWAY_URL="http://localhost:18789"

# Optional: Default OpenClaw model / agent IDs
OPENCLAW_DEFAULT_MODEL="openclaw/default"
OPENCLAW_TRANSCRIBE_MODEL="whisper-1"
OPENCLAW_SPEECH_MODEL="tts-1"
OPENCLAW_SPEECH_VOICE="alloy"

# Optional: HashiCorp Vault (for server-side provider secret lookup in /api/llm)
# VAULT_ADDR="http://localhost:8200"
# VAULT_TOKEN=""
# VAULT_NAMESPACE=""

# Optional: Supabase (only required if enabling cross-device cloud sync)
# SUPABASE_PROJECT_ID=""
# SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_URL=""
# VITE_SUPABASE_PROJECT_ID=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""
# VITE_SUPABASE_URL=""

# Clinic reception tooling
CLINIC_TOOLS_TOKEN=""
# Optional: webhook endpoint for escalation notifications.
# If unset, escalate_to_human returns delivery_failed truthfully.
# ESCALATION_WEBHOOK_URL="https://example.invalid/clinic/escalation"

# Optional: tenant slug used by clinic bridge mode
CLINIC_TENANT_SLUG="demo-dental"
