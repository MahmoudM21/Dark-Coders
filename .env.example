# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_URL="http://localhost:18789"
OPENCLAW_API_KEY=""
VITE_OPENCLAW_GATEWAY_URL="http://localhost:18789"

# Optional: Default OpenClaw model / agent IDs
OPENCLAW_DEFAULT_MODEL="openclaw/default"
OPENCLAW_TRANSCRIBE_MODEL="whisper-1"
OPENCLAW_SPEECH_MODEL="tts-1"
OPENCLAW_SPEECH_VOICE="alloy"

# Direct Postgres connection string. Only the psql steps need it: applying
# supabase/migrations/20261015120000_clinic_reception.sql, supabase/seed_clinic_demo.sql,
# supabase/reset_demo.sql and running supabase/tests/clinic_smoke.sql. The app itself never
# reads it — the clinic Booking Service uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY over REST.
# Either name works and both are accepted by scripts/preflight.mjs:
#   DATABASE_URL  the name the docs' psql commands use
#   POSTGRES_URL  the name this project's .env ships
# Use Supabase -> Connect -> Session pooler (IPv4) and the DATABASE password, never the
# service-role key, and keep ?sslmode=require. Never commit the value.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# POSTGRES_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: HashiCorp Vault (for server-side provider secret lookup in /api/llm)
# VAULT_ADDR="http://localhost:8200"
# VAULT_TOKEN=""
# VAULT_NAMESPACE=""

# Supabase / Postgres. The clinic Booking Service uses the SERVER client
# (src/integrations/supabase/client.server.ts), which reads exactly these two
# variables and throws if either is missing. They are server-only: never prefix
# them with VITE_ and never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: browser-side Supabase values, only for cross-device cloud sync.
# SUPABASE_PROJECT_ID=""
# SUPABASE_PUBLISHABLE_KEY=""
# VITE_SUPABASE_PROJECT_ID=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""
# VITE_SUPABASE_URL=""

# Clinic reception tooling
# Shared bearer token for /api/clinic/tools. The MCP proxy sends it; the route
# compares it in constant time. Generate one, e.g. `openssl rand -hex 32`.
CLINIC_TOOLS_TOKEN=""
# Optional: webhook endpoint for escalation notifications.
# If unset, escalate_to_human returns delivery_failed truthfully.
# ESCALATION_WEBHOOK_URL="https://example.invalid/clinic/escalation"

# Optional: tenant slug used by clinic bridge mode
CLINIC_TENANT_SLUG="demo-dental"
